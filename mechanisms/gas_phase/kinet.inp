$ double precision :: K_10_N2_H, K_21_N2_H, K_32_N2_H, K_43_N2_H, K_54_N2_H, K_65_N2_H, K_76_N2_H, K_87_N2_H ! Since we have eight reactions for N2_H (V-T)

