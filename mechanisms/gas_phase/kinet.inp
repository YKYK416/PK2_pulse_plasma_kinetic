N2(v5) + H  => N2(v4) + H                          !   K_54_N2_H
N2(v4) + H  => N2(v5) + H                          !   8.3d-20 * exp(-(E_v5_N2-E_v4_N2)/(1.38064852d-23*Tgas*6.242d18))

