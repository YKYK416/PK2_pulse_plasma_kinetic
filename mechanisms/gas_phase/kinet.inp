H2(v3) + N2(v6) => H2(v2) + N2(v7)             		! VV_3627_H2_N2
H2(v2) + N2(v7) => H2(v3) + N2(v6)             		! VV_3627_H2_N2 * exp(-(E_v3_H2-E_v2_H2+E_v6_N2-E_v7_N2)/(1.38064852d-23*Tgas*6.242d18))

